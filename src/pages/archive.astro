---
import Desktop from '../layouts/Desktop.astro';
import Window from '../components/Window.astro';
import { getPosts, fmt } from '../lib/data';

const posts = await getPosts();
const months = new Map<string, typeof posts>();
for (const p of posts) {
  const key = fmt(p.data.date).slice(0, 7);
  months.set(key, [...(months.get(key) || []), p]);
}
---

<Desktop title="월별로 보기">
  <Window id="archive" title="월별로 보기" open x={190} y={58} w={540}>
    {
      [...months].map(([month, list]) => (
        <>
          <p class="month">{month}</p>
          <ul class="rows">
            {list.map((p) => (
              <li>
                <span class="t">
                  <a href={`/posts/${p.data.slug}/`}>{p.data.title}</a>
                  {p.data.kind && <span class="k">{p.data.kind}</span>}
                </span>
                <span class="d">{fmt(p.data.date).slice(5)}</span>
              </li>
            ))}
          </ul>
        </>
      ))
    }
  </Window>
</Desktop>

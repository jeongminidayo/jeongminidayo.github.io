---
import '@fontsource/ibm-plex-sans-kr/400.css';
import '@fontsource/ibm-plex-sans-kr/500.css';
import '@fontsource/ibm-plex-sans-kr/600.css';
import '../styles/global.css';
import Window from '../components/Window.astro';
import { getPosts, getListed, getAbout, getLectures, lectureDate, fmt } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
  /** 이 페이지에서 처음부터 열려 있는 창. 'home'이면 글과 소개(글이 없으면 강의와 소개). */
  open?: string[] | 'home';
  ogType?: 'website' | 'article';
}
const { title, description, open = [], ogType = 'website' } = Astro.props;

const about = getAbout();
const posts = await getPosts();
const files = await getListed('files');
const works = await getListed('works');
const lectures = getLectures();
const kinds = [...new Set(posts.map((p) => p.data.kind).filter(Boolean))];

// 글이 아직 없으면 강의 창이 글 창 자리(왼쪽 위)를 쓴다.
const noPosts = posts.length === 0;
const opened = open === 'home' ? [posts.length ? 'posts' : 'lectures', 'about'] : open;
const isOpen = (id: string) => opened.includes(id);
// 창 하나만 열린 페이지에서는 그 창을 가운데 자리에 크게 둔다.
const solo = opened.length === 1 ? opened[0] : null;
// 여러 창이 같이 열릴 땐 2×2로 나눠 놓는다. h는 창 높이 한도(넘치면 창 안에서 스크롤) — 위 칸 창이 길어져도 아래 칸 창의 제목줄을 덮지 않게 한다.
const place = (id: string, x: number, y: number, w: number, h?: number) =>
  solo === id ? { x: 150, y: 76, w: 540 } : { x, y, w, h };

const paragraphs = about.body.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const pageTitle = title ? `${title} | ${about.name}` : about.name;
const pageDesc = description || paragraphs.join(' ');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={about.name} href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={about.name} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="desk">
      <header class="menubar">
        <a class="who" href="/">{about.name}</a>
        <a href="/posts/" data-open="posts">글</a>
        <a href="/lectures/" data-open="lectures">강의</a>
        <a href="/files/" data-open="files">자료실</a>
        {works.length > 0 && <a href="/works/" data-open="works">만든 것</a>}
        <a href="/about/" data-open="about">소개</a>
        <span class="right">
          <a href="/search/">검색</a>
          <button type="button" class="theme" id="theme" aria-label="밝은 화면과 어두운 화면 바꾸기">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
              <path d="M8 1.5 A6.5 6.5 0 0 1 8 14.5 Z" fill="currentColor"></path>
            </svg>
          </button>
          <span class="date" id="today"></span>
        </span>
      </header>

      <nav class="icons" aria-label="폴더">
        <a class="icon" href="/posts/" data-open="posts">
          <svg viewBox="0 0 44 36" aria-hidden="true"><path d="M2 8 V32 H42 V10 H20 L16 4 H2 Z"></path></svg>글
        </a>
        <a class="icon" href="/lectures/" data-open="lectures">
          <svg viewBox="0 0 44 36" aria-hidden="true"><path d="M2 8 V32 H42 V10 H20 L16 4 H2 Z"></path></svg>강의
        </a>
        <a class="icon" href="/files/" data-open="files">
          <svg viewBox="0 0 44 36" aria-hidden="true"><path d="M2 8 V32 H42 V10 H20 L16 4 H2 Z"></path></svg>자료실
        </a>
        {
          works.length > 0 && (
            <a class="icon" href="/works/" data-open="works">
              <svg viewBox="0 0 44 36" aria-hidden="true"><path d="M2 8 V32 H42 V10 H20 L16 4 H2 Z" /></svg>만든 것
            </a>
          )
        }
        <a class="icon" href="/about/" data-open="about">
          <svg viewBox="0 0 44 36" aria-hidden="true"><path d="M11 2 H27 L33 8 V34 H11 Z M27 2 V8 H33"></path></svg>소개
        </a>
      </nav>

      <main>
        <slot />

        <Window id="posts" title="글" open={isOpen('posts')} {...place('posts', 150, 76, 480, 372)}>
          {
            kinds.length > 1 && (
              <div class="chips" role="group" aria-label="분류로 거르기">
                <button type="button" data-kind="" aria-pressed="true">전체</button>
                {kinds.map((k) => (
                  <button type="button" data-kind={k} aria-pressed="false">{k}</button>
                ))}
              </div>
            )
          }
          <ul class="rows" id="post-rows">
            {
              posts.map((p) => (
                <li data-kind={p.data.kind}>
                  <span class="t">
                    <a href={`/posts/${p.data.slug}/`}>{p.data.title}</a>
                    {p.data.kind && <span class="k">{p.data.kind}</span>}
                  </span>
                  <span class="d">{fmt(p.data.date)}</span>
                </li>
              ))
            }
          </ul>
          <div class="win-foot">
            <a href="/archive/">월별로 보기</a>
            <a href="/rss.xml">RSS</a>
          </div>
        </Window>

        <Window id="about" title="소개" open={isOpen('about')} {...place('about', 660, noPosts ? 76 : 470, 400)}>
          <div class="about">
            {paragraphs.map((p) => <p>{p}</p>)}
            {
              (about.mail || about.links.length > 0) && (
                <div class="contact">
                  {about.mail && (
                    <p>
                      문의 <a href={`mailto:${about.mail}`}>{about.mail}</a>
                    </p>
                  )}
                  {about.links.map((l) => (
                    <p>
                      <a href={l.url} rel="me noopener">{l.label}</a>
                    </p>
                  ))}
                </div>
              )
            }
          </div>
        </Window>

        <Window id="lectures" title="강의" open={isOpen('lectures')} {...place('lectures', noPosts ? 150 : 660, 76, noPosts ? 480 : 400, 372)}>
          <ul class="rows">
            {
              lectures.rows.map((l) => (
                <li>
                  <span class="t">
                    {l.org}
                    <span class="desc">{[l.topic, l.role].filter(Boolean).join(', ')}</span>
                  </span>
                  <span class="d">{lectureDate(l)}</span>
                </li>
              ))
            }
          </ul>
        </Window>

        <Window id="files" title="자료실" open={isOpen('files')} {...place('files', 150, 470, 480, 300)}>
          <ul class="rows">
            {
              files.map((f) => (
                <li>
                  <span class="t">
                    {f.data.link ? <a href={f.data.link}>{f.data.title}</a> : f.data.title}
                    {f.data.desc && <span class="desc">{f.data.desc}</span>}
                  </span>
                  <span class="d">{fmt(f.data.date)}</span>
                </li>
              ))
            }
          </ul>
        </Window>

        {
          works.length > 0 && (
            <Window id="works" title="만든 것" open={isOpen('works')} {...place('works', 400, 240, 420, 340)}>
              <ul class="rows">
                {works.map((f) => (
                  <li>
                    <span class="t">
                      {f.data.link ? <a href={f.data.link}>{f.data.title}</a> : f.data.title}
                      {f.data.desc && <span class="desc">{f.data.desc}</span>}
                    </span>
                    <span class="d">{fmt(f.data.date)}</span>
                  </li>
                ))}
              </ul>
            </Window>
          )
        }
      </main>
    </div>

    <script>
      const desk = document.querySelector<HTMLElement>('.desk')!;
      const narrow = window.matchMedia('(max-width: 760px)');
      const floating = () => [...document.querySelectorAll<HTMLElement>('.win:not(.sheet)')];
      let top = 10;

      const raise = (w: HTMLElement) => {
        w.style.zIndex = String(++top);
      };

      // 화면이 좁으면 창이 오른쪽으로 잘리지 않게 안으로 당긴다.
      const fit = (w: HTMLElement) => {
        if (narrow.matches || w.hidden) return;
        const maxLeft = Math.max(12, desk.clientWidth - w.offsetWidth - 12);
        if (w.offsetLeft > maxLeft) w.style.left = `${maxLeft}px`;
      };

      const openWin = (id: string) => {
        const w = document.querySelector<HTMLElement>(`.win[data-win="${id}"]`);
        if (!w) return false;
        const wasHidden = w.hidden;
        w.hidden = false;
        raise(w);
        fit(w);
        if (wasHidden) {
          w.classList.add('opening');
          w.addEventListener('animationend', () => w.classList.remove('opening'), { once: true });
        }
        if (narrow.matches) w.scrollIntoView({ block: 'start', behavior: 'smooth' });
        return true;
      };

      // 메뉴·폴더: 그 창이 이 화면에 있으면 페이지를 옮기지 않고 창을 연다.
      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest<HTMLElement>('[data-open]');
        if (link && openWin(link.dataset.open!)) e.preventDefault();
      });

      for (const w of floating()) {
        if (!w.hidden) raise(w);
        fit(w);
        w.addEventListener('pointerdown', () => raise(w));
        w.querySelector('button.win-x')?.addEventListener('click', () => {
          w.hidden = true;
        });

        const bar = w.querySelector<HTMLElement>('.win-bar')!;
        let drag: { x: number; y: number; left: number; top: number } | null = null;
        bar.addEventListener('pointerdown', (e) => {
          if (narrow.matches || (e.target as HTMLElement).closest('.win-x')) return;
          drag = { x: e.clientX, y: e.clientY, left: w.offsetLeft, top: w.offsetTop };
          bar.setPointerCapture(e.pointerId);
        });
        bar.addEventListener('pointermove', (e) => {
          if (!drag) return;
          const left = Math.max(0, Math.min(drag.left + e.clientX - drag.x, desk.clientWidth - 80));
          const y = Math.max(44, Math.min(drag.top + e.clientY - drag.y, desk.clientHeight - 40));
          w.style.left = `${left}px`;
          w.style.top = `${y}px`;
        });
        const stop = () => {
          drag = null;
        };
        bar.addEventListener('pointerup', stop);
        bar.addEventListener('pointercancel', stop);
      }
      window.addEventListener('resize', () => floating().forEach(fit));

      // 글 창의 분류 거르기
      const chips = document.querySelectorAll<HTMLButtonElement>('.chips button');
      chips.forEach((chip) =>
        chip.addEventListener('click', () => {
          const kind = chip.dataset.kind || '';
          chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
          document.querySelectorAll<HTMLElement>('#post-rows li').forEach((li) => {
            li.hidden = kind !== '' && li.dataset.kind !== kind;
          });
        }),
      );

      // 메뉴 줄 오른쪽: 오늘 날짜, 화면 밝기
      const today = document.getElementById('today');
      if (today) {
        today.textContent = new Intl.DateTimeFormat('ko-KR', { month: 'long', day: 'numeric', weekday: 'long' }).format(new Date());
      }
      document.getElementById('theme')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try {
          localStorage.setItem('theme', root.dataset.theme);
        } catch {}
      });
    </script>
  </body>
</html>
